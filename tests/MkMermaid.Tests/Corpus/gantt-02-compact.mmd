---
displayMode: compact
---
gantt
    title A Gantt Diagram
    dateFormat HH:mm
    axisFormat %H:%M
    tickInterval 30minute
    section Section
    A task           :a1, 08:00, 30m
    Another task     :a2, 08:15, 1h
    Parallel         :a3, 08:45, 45m
    section Another
    Task in sec      :b1, after a1, 20m
    another task     :b2, 09:40, 10m
    Release          :vert, r1, 09:30, 0m
