root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,slnx,ps1}]
charset = utf-8-bom

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,props,slnx,json,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
